{
  "name": "CineForge AI Studio",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "CineForge Studio", "onAutoForward": "notify" },
    "8000": { "label": "CineForge API", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/serve.sh"
}