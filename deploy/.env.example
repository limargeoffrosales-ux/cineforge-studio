# CineForge AI Studio — VPS environment template
# Copy to .env on the server and fill in a strong secret:
#   cp .env.example .env && nano .env

# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# HTTPS proxy domain — REQUIRED only for `docker compose --profile proxy up -d`
# (auto-TLS). Leave empty to serve plain HTTP straight from :3000 / :8000.
CINEFORGE_DOMAIN=

# AI keys — optional. Without them the studio runs fully keyless:
#   video = built-in procedural renderer (real playable MP4s)
#   narration = free Microsoft Edge neural voices
OPENAI_API_KEY=
VEO_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
SEEDANCE_API_KEY=
ELEVENLABS_API_KEY=

# Pipeline speed — 0.7s per stage (demo feel). Set PIPELINE_FAST=true for snappy UX.
PIPELINE_STAGE_SECONDS=0.7
PIPELINE_FAST=true

# Narration provider: edge (free) | openai | elevenlabs
TTS_PROVIDER=edge
